NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://coaching_app:change-me@127.0.0.1:5432/coaching
DATABASE_SSL=require
OIDC_ISSUER=https://identity.example.org/
OIDC_AUDIENCE=coaching-platform
OIDC_LOGIN_URL=https://identity.example.org/authorize
AUTH_PUBLIC_KEY_BASE64=base64-encoded-RS256-public-key
WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-characters
BILLING_BASE_URL=https://billing.example.org
BILLING_BEARER_TOKEN=replace-me
VIDEO_BASE_URL=https://video.example.org
VIDEO_BEARER_TOKEN=replace-me
NOTIFICATION_BASE_URL=https://notifications.example.org
NOTIFICATION_BEARER_TOKEN=replace-me
ALLOW_SCHEMA_MIGRATION=0
ENABLE_LEGACY_DEMOS=0
